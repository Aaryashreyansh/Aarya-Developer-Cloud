# Local backend configuration. Copy this file to .env.
# Never put real API keys in GitHub source files or notebooks.
APP_NAME=Aarya Developer Cloud
APP_ENV=development

# OpenAI: set the model ID enabled for your API project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional additional providers. Add keys only if you choose to use them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
